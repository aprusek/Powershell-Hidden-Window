# Get all saved WiFi profiles and their passwords
$profiles = netsh wlan show profiles | 
    Select-String "All User Profile" | 
    ForEach-Object { ($_ -split ":")[1].Trim() }

$results = foreach ($profile in $profiles) {
    $details = netsh wlan show profile name="$profile" key=clear
    $password = ($details | Select-String "Key Content") -replace ".*:\s*", ""
    
    [PSCustomObject]@{
        "Network Name (SSID)" = $profile
        "Password"            = if ($password) { $password.Trim() } else { "(none / open)" }
    }
}

$results | Sort-Object "Network Name (SSID)" | Out-GridView -Title "Saved WiFi Passwords" -Wait